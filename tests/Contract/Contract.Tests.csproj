    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="PactNet" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>
</Project>