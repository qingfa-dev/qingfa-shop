{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=qingfa;Username=qingfa;Password=qingfa",
    "Cache": "localhost:6379"
  },
  "EfCore": {
    "ConnectionStringName": "Default",
    "Provider": "PostgreSQL",
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true,
    "CommandTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMs": 100
  },
  "Caching": {
    "Enabled": false,
    "Memory": {
      "Enabled": true,
      "DefaultExpiration": "00:05:00",
      "SizeLimitBytes": 104857600,
      "CompactionPercentage": 10
    },
    "Distributed": {
      "Enabled": false,
      "DefaultExpiration": "00:05:00"
    },
    "Hybrid": {
      "MaximumPayloadBytes": 1048576,
      "MaximumKeyLength": 1024
    }
  }
}
