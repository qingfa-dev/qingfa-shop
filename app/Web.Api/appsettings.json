{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "qingfa-scaffold-only-signing-key-change-me-32+",
    "Issuer": "QingFa.Shop",
    "Audience": "QingFa.Shop.Clients",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "LifetimeDays": 7,
    "TokenByteLength": 32,
    "TokenPrefix": "rt_"
  },
  "TokenBlacklist": {
    "KeyPrefix": "auth:blacklist:",
    "Enabled": true
  }
}
