{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "qingfa-scaffold-only-signing-key-change-me-32+",
    "Issuer": "QingFa.Shop",
    "Audience": "QingFa.Shop.Clients",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshToken": {
    "LifetimeDays": 7,
    "TokenByteLength": 32,
    "TokenPrefix": "rt_"
  },
  "TokenBlacklist": {
    "KeyPrefix": "auth:blacklist:",
    "Enabled": true
  },
  "ExternalAuth": {
    "SuccessRedirectUrl": "/",
    "CodeLifetimeSeconds": 60,
    "Google": {
      "Enabled": false
    },
    "Microsoft": {
      "Enabled": false
    },
    "OpenIdConnect": {
      "Enabled": false
    }
  },
  "Authorization": {
    "PermissionCache": {
      "SlidingExpiration": "00:05:00",
      "AbsoluteExpiration": "00:30:00"
    }
  },
  "Notification": {
    "Channels": {
      "Email": {
        "FromEmail": "no-reply@qingfa.shop",
        "FromName": "QingFa Shop",
        "Providers": {
          "SendGrid": {
            "Enabled": false
          },
          "Smtp": {
            "Enabled": false
          }
        }
      },
      "Sms": {
        "DefaultSenderNumber": "+10000000000",
        "Providers": {
          "Sinch": {
            "Enabled": false
          }
        }
      }
    }
  },
  "Storage": {
    "DefaultProvider": "Local",
    "Providers": {
      "Local": {
        "IsEnabled": true
      },
      "Azure": {
        "IsEnabled": false
      },
      "S3": {
        "IsEnabled": false
      }
    }
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 100,
    "PollingIntervalSeconds": 2,
    "MaxAttempts": 10,
    "BackoffSeconds": 5,
    "MaxBackoffSeconds": 300,
    "LeaseSeconds": 60,
    "RetentionDays": 7,
    "MaxAgeSeconds": 300
  },
  "Messaging": {
    "Enabled": true,
    "Transport": "InMemory",
    "ExchangeName": "qingfa.events",
    "QueuePrefix": "qingfa",
    "PrefetchCount": 16,
    "MaxConcurrency": 8,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 2
  }
}
